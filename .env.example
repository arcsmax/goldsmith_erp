# Goldsmith ERP - Environment Variables Configuration
# Copy this file to .env and update the values.
#
# This template mirrors src/goldsmith_erp/core/config.py (the Settings class).
# Every variable below maps to a Settings field. Vars whose defaults are fine
# for local development are shown with their default; production-only knobs and
# secrets are flagged. Production deployments should use setup.sh, which writes a
# hardened .env.production (secrets generated, DEBUG=false, COOKIE_SECURE=true).

# =====================================================
# SERVER SETTINGS
# =====================================================
HOST=0.0.0.0
PORT=8000
# DEBUG=true relaxes the production fail-fast validators (ENCRYPTION_KEY,
# ANONYMIZATION_SALT, COOKIE_SECURE, SMTP, CORS wildcard) to warnings. Set
# DEBUG=false in production — several settings then hard-fail on boot if unsafe.
DEBUG=true

# =====================================================
# SECURITY - IMPORTANT!
# =====================================================
# Generate a secure SECRET_KEY with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# The placeholder below is public. With DEBUG=false the backend refuses to boot
# while SECRET_KEY (or ANONYMIZATION_SALT) still holds it; with DEBUG=true it
# only logs a warning (SEC-02).
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS

# Access-token lifetime in minutes. Leave unset to use the config default
# (30 min); the frontend refreshes the token transparently. Long-lived tokens
# widen the window in which a stolen token works (SEC-03).
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Token-revocation availability tradeoff. The auth dependency checks a Redis
# jti-blocklist / per-user invalid-before mark on every request. If Redis is
# unreachable the default (false) FAILS OPEN — accepts the token and logs a
# warning — the right call for a single-workshop LAN where an internal Redis
# blip must not lock everyone out. Set to true to FAIL CLOSED instead (reject
# the request when Redis is down): higher security, lower availability.
# AUTH_REVOCATION_FAIL_CLOSED=false

# =====================================================
# DATABASE (PostgreSQL)
# =====================================================
POSTGRES_USER=user
# REQUIRED — dev compose files (docker-compose.yml, podman-compose.yml)
# will refuse to start without this. Use any value locally, but NEVER reuse
# this placeholder in production. Production uses podman-compose.prod.yml
# which reads DB_PASSWORD from a secret manager. setup.sh generates it with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=changeme
POSTGRES_DB=goldsmith
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Dev DB port binds to 127.0.0.1 by default. Set DB_HOST_IP=0.0.0.0 (or a
# specific LAN IP) if you genuinely need the dev DB reachable from another
# machine. Do NOT do this on an untrusted network.
# DB_HOST_IP=127.0.0.1

# Optional: Override the entire DATABASE_URL
# DATABASE_URL=postgresql+asyncpg://user:changeme@db:5432/goldsmith

# =====================================================
# REFERENCE-DATA SEED (production bootstrap)
# =====================================================
# The production backend seeds reference data (the 15 standard activities +
# the standard materials catalogue) after migrations on every boot. This is
# idempotent and creates NO users, customers or demo data — see
# docs/technical/infrastructure/DATABASE_SEEDING.md.
# Set to false/0/no/off to skip the boot-time seed (e.g. if you restore
# reference data from a backup or manage it manually). Default: true.
SEED_REFERENCE_DATA=true

# =====================================================
# CONNECTION POOLING (SQLAlchemy async engine)
# =====================================================
# Defaults are sensible for a single-workshop deployment; tune only under load.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800  # seconds — recycle stale connections after 30 min

# =====================================================
# REDIS (Caching & Pub/Sub)
# =====================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Optional: Override the entire REDIS_URL
# REDIS_URL=redis://redis:6379/0

# Dev compose (docker-compose.yml / podman-compose.yml) binds the published
# Redis port to 127.0.0.1 by default — it has no password and must never be
# reachable from the LAN (SEC-08). Set REDIS_HOST_IP=0.0.0.0 (or a specific
# LAN IP) only if you genuinely need it reachable from another machine, and
# never with real customer data — see README.md.
# REDIS_HOST_IP=127.0.0.1

# Same idea for the dev backend's published port: DEBUG=true relaxes every
# production validator and the backend serves plain HTTP. Override
# BACKEND_HOST_IP only for a deliberate, trusted LAN use case.
# BACKEND_HOST_IP=127.0.0.1

# =====================================================
# CORS (Cross-Origin Resource Sharing)
# =====================================================
# Allowed origins for CORS (comma-separated OR JSON array — both parse).
# In production (DEBUG=false) a wildcard '*' (or any entry containing '*') is
# REJECTED on boot: combined with credentialed requests it is a security hole.
# List explicit origins (add the workshop's LAN IP / domain for other devices).
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://localhost:8000"]'

# =====================================================
# WORKSHOP / APPLICATION IDENTITY
# =====================================================
# Name shown in the UI and email footers.
WORKSHOP_NAME=Goldschmiede
# Optional contact line (e.g. "Tel. 01234 56789") rendered in the email footer.
# WORKSHOP_CONTACT=

# =====================================================
# ENCRYPTION (PII field encryption at rest — GDPR)
# =====================================================
# Fernet key encrypting customer PII and insurance valuations at rest.
# REQUIRED in production: config.py hard-fails on boot when DEBUG=false and this
# is unset (in dev it only warns, and PII is stored unencrypted).
# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# ====================================================================
# ANONYMIZATION SALT (GDPR Art. 17 — pseudonymization)
# ====================================================================
# HMAC salt for user-anonymization sentinel derivation. REQUIRED in production
# (config.py hard-fails when DEBUG=false and this is unset).
#
# DO NOT ROTATE this value after the first erasure event has been
# processed. Rotating invalidates all prior anonymization hashes —
# previously anonymized records become unlinkable to the original
# sentinel, which destroys the audit trail that Art. 17 explicitly
# permits preserving.
#
# If compromised: consult DPO and plan a controlled rotation with
# re-processing of all affected sentinel records.
#
# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#
# See docs/superpowers/plans/qr-barcode-workflow/
# V1.1-ANONYMIZE-USER-CONTRACT.md §4 for the full rotation policy.
ANONYMIZATION_SALT=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS

# =====================================================
# COOKIE SECURITY
# =====================================================
# The HttpOnly auth cookie is marked Secure (browsers only send it over HTTPS)
# when this is true. REQUIRED in production: config.py hard-fails when
# DEBUG=false and COOKIE_SECURE=false (the cookie would cross the LAN in
# cleartext). Keep false for local dev over plain HTTP; TLS is terminated by the
# Caddy reverse proxy in production (docs/technical/infrastructure/PRODUCTION_TLS.md).
COOKIE_SECURE=false

# =====================================================
# CUSTOMER PORTAL (SEC-10, decision D-03)
# =====================================================
# Public self-service order/repair status lookup (/api/v1/portal/*). Off by
# default: no live customer portal until W6-07's GDPR hardening ships. Set
# true only for a deliberate LAN-only opt-in.
CUSTOMER_PORTAL_ENABLED=false

# =====================================================
# BACKUP (scripts/backup.sh)
# =====================================================
# Directory where compressed, verified DB dumps are written.
BACKUP_DIR=~/goldsmith-backups
# Optional off-site sync target (e.g. an rclone remote); leave unset to skip.
# BACKUP_CLOUD_URL=
#
# Encryption at rest (GDPR-06). backup.sh REFUSES to write a plain dump
# unless run with --unencrypted (development only). Keys are read from FILES,
# never passed on the command line. Pick one:
#   age (recommended): the server holds only the public key; the private key
#   stays offline (Anne's safe) and is needed only to restore.
#     age-keygen -o backup-age.key && age-keygen -y backup-age.key > backup-age.pub
# BACKUP_AGE_RECIPIENTS_FILE=/home/goldsmith/.config/goldsmith/backup-age.pub
# BACKUP_AGE_IDENTITY_FILE=     # set only on the host doing a restore
#   gpg symmetric (fallback when age is not installed), file mode 0600:
#     head -c 48 /dev/urandom | base64 > backup.pass && chmod 600 backup.pass
# BACKUP_PASSPHRASE_FILE=/home/goldsmith/.config/goldsmith/backup.pass
# BACKUP_ENCRYPTION=            # optional override: age | gpg
#
# Erasure ledger (GDPR-07): executed Art. 17 erasures, appended after every
# backup and replayed by restore.sh. Outside the dump rotation; copy it
# off-site together with the dumps.
# ERASURE_LEDGER_FILE=~/goldsmith-backups/erasure-ledger/erasure-ledger.jsonl

# =====================================================
# RETENTION SWEEP (GDPR-08, decision D-08)
# =====================================================
# false = the weekly sweep only LOGS what it would delete (dry-run).
# Set true only after the written sign-off of
# docs/technical/RETENTION_SCHEDULE.md (Anne + data-protection adviser).
RETENTION_EXECUTE=false

# =====================================================
# OPTIONAL: EMAIL (for notifications — V1.2 customer updates)
# =====================================================
# The email service degrades gracefully to PDF-only mode when unset. To enable,
# set EMAIL_NOTIFICATIONS_ENABLED=true AND at least SMTP_HOST + SMTP_FROM
# (config.py fails loudly in production if enabled but not fully configured).
# EMAIL_NOTIFICATIONS_ENABLED=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@goldsmith-erp.local

# =====================================================
# FILE STORAGE ROOT (GDPR Art. 17 file erasure)
# =====================================================
# Root directory for filesystem artefacts referenced by DB path columns
# (generated PDFs, uploaded photos, scrap-gold receipts).
#
# The FileErasureService deletes every file referenced by a row linked to
# an erased customer. It refuses to delete any path that escapes this
# root (path-traversal guard).
#
# Production deployments MUST override with a path that contains ONLY the
# uploaded / generated artefact tree.
FILE_STORAGE_ROOT=./uploads

# =====================================================
# OPTIONAL: PHOTO UPLOAD
# =====================================================
# PHOTO_STORAGE_PATH=./uploads/photos
# PHOTO_MAX_SIZE_MB=8

# Decompression-bomb protection (SEC-18): images are rejected from their
# declared header dimensions before Pillow decodes the full pixel buffer.
# IMAGE_MAX_MEGAPIXELS=40
# IMAGE_MAX_UPLOAD_BYTES=8388608
# IMAGE_PROCESSING_TIMEOUT_SECONDS=10

# =====================================================
# OPTIONAL: COST WATCHER (§649 BGB Anzeigepflicht — V1.2)
# =====================================================
# The watcher alerts when EITHER threshold is crossed (percent OR absolute).
# COST_ALERT_THRESHOLD_PERCENT=15.0
# COST_ALERT_THRESHOLD_ABS_EUR=150.0
# Fallback hourly rate for projected-cost labor when an order has no explicit rate.
# DEFAULT_HOURLY_RATE=75.0

# =====================================================
# OPTIONAL: METAL PRICE SERVICE
# =====================================================
# External API for live spot prices; falls back to DB history then the hardcoded
# EUR/gram defaults below when unset.
# METAL_PRICE_API_URL=
# METAL_PRICE_CACHE_TTL=3600  # seconds a fetched price set is cached in Redis
# METAL_PRICE_FALLBACK_GOLD=75.0
# METAL_PRICE_FALLBACK_SILVER=0.85
# METAL_PRICE_FALLBACK_PLATINUM=30.0

# =====================================================
# OPTIONAL: ACCOUNTING EXPORT (DATEV / lexoffice — BE-13, W1-09)
# =====================================================
# Revenue account per VAT rate (SKR03 chart of accounts), as a JSON object
# mapping the rate (no trailing ".0") to the account number. Only 19 -> "8400"
# is confirmed from the original code; get the 7% and 0% accounts from your
# Steuerberater before invoicing at those rates — the export refuses a rate
# with no entry here rather than silently booking it to the wrong account.
# DATEV_REVENUE_ACCOUNTS={"19": "8400", "7": "8300", "0": "8200"}
# Gegenkonto (counter-account) for the receivables side of every booking.
# DATEV_RECEIVABLES_ACCOUNT=1400

# METAL_PRICE_HTTP_TIMEOUT_SECONDS=10.0  # outbound API call timeout (W2-15)
# METAL_PRICE_STALENESS_HOURS=24.0       # "veraltet" threshold in the estimator/quote UI (W2-15)
