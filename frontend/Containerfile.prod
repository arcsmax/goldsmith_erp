# syntax=docker/dockerfile:1
# Production frontend image for Goldsmith ERP.
#
# Stage 1 builds the Vite bundle; stage 2 serves the static dist/ with a
# non-root nginx that also proxies API/WS/upload traffic to the backend
# (see nginx.conf). This replaces the dev-only Containerfile, whose
# `CMD ["yarn","dev"]` runs the Vite dev server — never appropriate for prod.
#
# Build:  docker build -f Containerfile.prod -t goldsmith-frontend .
# Compose: podman-compose.prod.yml points the frontend service here.

# --------------------------------------------------------------------------
# Stage 1 — build the static bundle
# --------------------------------------------------------------------------
# Node 22: Vite 7 requires Node 20.19+/22.12+. The dev Containerfile pins
# node:18 because it only runs the dev server, but `yarn build` here needs a
# supported runtime.
FROM docker.io/library/node:22-alpine AS build

WORKDIR /app

# Toolchain for any node-gyp native deps.
RUN apk add --no-cache python3 make g++ \
 && rm -rf /var/cache/apk/*

# Copy manifests first for layer caching. .yarnrc.yml is required so Yarn 4
# uses the node-modules linker (the repo's setting) instead of defaulting to
# Plug'n'Play during install.
COPY package.json yarn.lock .yarnrc.yml ./
RUN corepack enable \
 && yarn install --immutable

# Copy the rest of the source (node_modules/dist excluded via .dockerignore so
# a host-built, wrong-platform node_modules never clobbers the one installed
# above) and build.
COPY . .

# The client uses a relative baseURL ("/api/v1") and reads no VITE_API_URL, so
# there is deliberately no API-URL build arg — routing is handled by the nginx
# proxy in stage 2.
RUN yarn build

# --------------------------------------------------------------------------
# Stage 2 — serve with non-root nginx
# --------------------------------------------------------------------------
# nginx-unprivileged runs as uid 101 with its master/worker both non-root and
# temp/pid paths under /tmp — matching the repo's rootless-container convention.
FROM docker.io/nginxinc/nginx-unprivileged:1.27-alpine

# SPA + reverse-proxy config (listens on 3000).
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Static bundle.
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:3000/ || exit 1
